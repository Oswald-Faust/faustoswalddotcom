# Admin dashboard (/admin)
ADMIN_PASSWORD=choose-a-long-password
# 32+ random characters: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional: store content and uploads in Supabase (required on read-only hosts like Vercel).
# Without these, the dashboard saves to data/content.json.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; its SHA-256 hash must be registered in public.site_secrets
# (see supabase/migrations). Generate with: openssl rand -hex 32
CONTENT_WRITE_TOKEN=
